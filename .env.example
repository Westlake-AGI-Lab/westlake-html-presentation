# OpenAI API Key 仅供 server.py 在服务端读取，不要写进 HTML 或提交到公开仓库。
OPENAI_API_KEY=sk-your-key-here

# 可选：覆盖默认模型和端口。
OPENAI_MODEL=gpt-5.5
PORT=8765
MAX_OUTPUT_TOKENS=3000

# 内网部署时明确设置访问范围；默认只允许本机。不要直接用于公网。
ALLOWED_HOSTS=localhost,127.0.0.1,::1
ALLOWED_NETWORKS=127.0.0.0/8,::1/128
CHAT_REQUESTS_PER_HOUR=30
CHAT_REQUESTS_PER_DAY=200
CHAT_MAX_CONCURRENT=2
# 可选：独立的私有 JSON 配置文件路径。
# PPT_CONFIG_PATH=/absolute/private/config.json
